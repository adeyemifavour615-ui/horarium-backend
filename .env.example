# Copy to .env for local dev. In production, set these as environment
# variables in your host's dashboard (Render/Railway/Fly.io/etc.) instead
# of uploading a .env file.

PORT=3000

# MongoDB Atlas connection string (Network Access must allow your host's
# IP, or 0.0.0.0/0 if your host uses dynamic egress IPs)
MONGODB_URI=

JWT_SECRET=

# Gmail address + an App Password (not your regular password) used to send
# invite/welcome emails via nodemailer
EMAIL_USER=
EMAIL_PASS=

ADMIN_SIGNUP_CODE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Your deployed frontend's origin (comma-separate multiple, e.g. a
# production domain + a Vercel preview URL). Must NOT have a trailing slash.
CLIENT_URL=http://localhost:5173
